# notelinks: provider access (OpenAI SDK pointed at OpenRouter; one key for
# both embeddings and the judge — see design.md §3).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# notelinks: run the JUDGE on a local Ollama model (T18). Embeddings ALWAYS use
# OpenRouter, so OPENROUTER_API_KEY above is still required even with a local
# judge. To enable: run `ollama serve`, `ollama pull <tag>`, then uncomment:
# NOTELINKS_JUDGE_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=gemma3n:e2b

# notelinks: corpus root (the org-roam notes dir) and Chroma index location.
# Optional; overridable on the CLI (see design.md §11/§12).
# NOTELINKS_CORPUS_DIR=
# NOTELINKS_INDEX_DIR=   # defaults to <corpus_dir>/dbs/notelinks_index